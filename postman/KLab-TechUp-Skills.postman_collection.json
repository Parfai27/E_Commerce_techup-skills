{
  "info": {
    "name": "KLab TechUp Skills API",
    "description": "Checks the Express product API at http://localhost:1000. Start the server with `npm run dev`, then import this collection in Postman and run it with the Collection Runner.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:1000"
    },
    {
      "key": "productId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Welcome",
      "item": [
        {
          "name": "GET /",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('body is Hello World!', function () {",
                  "  pm.expect(pm.response.text()).to.eql('Hello World!');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "List products",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const products = pm.response.json();",
                  "pm.test('returns the seeded products', function () {",
                  "  pm.expect(products).to.be.an('array').with.lengthOf.at.least(2);",
                  "  pm.expect(products[0]).to.include({ id: 1, name: 'I Phone 17 Pro', category: 'Electronic', price: 8000 });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get product by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products/1"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('returns product 1', function () {",
                  "  pm.expect(pm.response.json()).to.include({ id: 1, name: 'I Phone 17 Pro' });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get missing product",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products/9999"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 404', function () {",
                  "  pm.response.to.have.status(404);",
                  "});",
                  "pm.test('explains that the product is missing', function () {",
                  "  pm.expect(pm.response.json()).to.have.property('message', 'Product Not found');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create product without required fields",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Missing fields\"\n}"
            },
            "url": "{{baseUrl}}/api/products"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', function () {",
                  "  pm.response.to.have.status(400);",
                  "});",
                  "pm.test('requires name, category, and price', function () {",
                  "  pm.expect(pm.response.json()).to.have.property('message', 'name , category and price are required');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Samsung Galaxy\",\n  \"category\": \"Electronic\",\n  \"price\": 6500\n}"
            },
            "url": "{{baseUrl}}/api/products"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('returns the created product', function () {",
                  "  pm.expect(body.message).to.eql('Product added ');",
                  "  pm.expect(body.product).to.include({ name: 'Samsung Galaxy', category: 'Electronic', price: 6500 });",
                  "  pm.expect(body.product.id).to.be.a('number');",
                  "});",
                  "pm.collectionVariables.set('productId', String(body.product.id));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get created product",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products/{{productId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('returns the product saved from create', function () {",
                  "  pm.expect(pm.response.json()).to.include({",
                  "    id: Number(pm.collectionVariables.get('productId')),",
                  "    name: 'Samsung Galaxy'",
                  "  });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update product",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 7000\n}"
            },
            "url": "{{baseUrl}}/api/products/{{productId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('updates price and keeps the other fields', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.message).to.eql('Product Updated successfull');",
                  "  pm.expect(body.product).to.include({ name: 'Samsung Galaxy', category: 'Electronic', price: 7000 });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update missing product",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 1\n}"
            },
            "url": "{{baseUrl}}/api/products/9999"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 404', function () {",
                  "  pm.response.to.have.status(404);",
                  "});",
                  "pm.test('explains that the product is missing', function () {",
                  "  pm.expect(pm.response.json()).to.have.property('message', 'product notfound');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete product",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/products/{{productId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('returns the deleted product', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.message).to.eql('Product delete Successfully');",
                  "  pm.expect(body.product).to.be.an('array').with.lengthOf(1);",
                  "  pm.expect(body.product[0]).to.include({ name: 'Samsung Galaxy', price: 7000 });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get deleted product",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products/{{productId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 404', function () {",
                  "  pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete missing product",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/products/9999"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 404', function () {",
                  "  pm.response.to.have.status(404);",
                  "});",
                  "pm.test('explains that the product is missing', function () {",
                  "  pm.expect(pm.response.json()).to.have.property('message', 'product is not Found');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
